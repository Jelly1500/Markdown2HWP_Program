2"><TEXT CharShape="60"><CHAR>○ 아래에 명시된 </CHAR></TEXT><TEXT CharShape="85"><CHAR>기능장 이상 자격증</CHAR></TEXT><TEXT CharShape="60"><CHAR> 소지자 또는 </CHAR></TEXT><TEXT CharShape="85"><CHAR>기사 자격증 소지 후 3년 이상, 산업기사 자격증 소지 후 6년 이상</CHAR></TEXT><TEXT CharShape="60"><CHAR> 직무관련 분야 근무 경력자</CHAR></TEXT></P><P ParaShape="75" Style="2"><TEXT CharShape="60"><CHAR><FWSPACE/><FWSPACE/></CHAR><TABLE BorderFill="3" CellSpacing="0" ColCount="2" PageBreak="Cell" RepeatHeader="true" RowCount="5"><SHAPEOBJECT InstId="1796414322" Lock="false" NumberingType="Table" ZOrder="63"><SIZE Height="8325" HeightRelTo="Absolute" Protect="false" Width="34473" WidthRelTo="Absolute"/><POSITION AffectLSpacing="false" AllowOverlap="false" FlowWithText="true" HoldAnchorAndSO="false" HorzAlign="Left" HorzOffset="0" HorzRelTo="Para" TreatAsChar="true" VertAlign="Top" VertOffset="0" VertRelTo="Para"/><OUTSIDEMARGIN Bottom="0" Left="0" Right="0" Top="0"/></SHAPEOBJECT><INSIDEMARGIN Bottom="141" Left="510" Right="510" Top="141"/><ROW><CELL BorderFill="55" ColAddr="0" ColSpan="2" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="1665" Protect="false" RowAddr="0" RowSpan="1" Width="34473"><CELLMARGIN Bottom="141" Left="510" Right="510" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="192" Style="21"><TEXT CharShape="60"><CHAR>대상 자격증</CHAR></TEXT></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="55" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="1665" Protect="false" RowAddr="1" RowSpan="1" Width="5831"><CELLMARGIN Bottom="141" Left="510" Right="510" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="192" Style="21"><TEXT CharShape="60"><CHAR>기술사</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="3" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="1665" P