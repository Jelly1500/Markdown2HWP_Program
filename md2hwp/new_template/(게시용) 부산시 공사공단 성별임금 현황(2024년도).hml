CELL BorderFill="37" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="2031" Protect="false" RowAddr="0" RowSpan="1" Width="7098"><CELLMARGIN Bottom="-1" Left="-1" Right="-1" Top="-1"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="38" Style="25"><TEXT CharShape="7"><CHAR>구분</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="38" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="2031" Protect="false" RowAddr="0" RowSpan="1" Width="20682"><CELLMARGIN Bottom="0" Left="0" Right="0" Top="0"/><PARALIST LineWrap="Squeeze" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="38" Style="26"><TEXT CharShape="7"><CHAR>여</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="38" ColAddr="2" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="2031" Protect="false" RowAddr="0" RowSpan="1" Width="21720"><CELLMARGIN Bottom="0" Left="0" Right="0" Top="0"/><PARALIST LineWrap="Squeeze" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="38" Style="25"><TEXT CharShape="7"><CHAR>부</CHAR></TEXT></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="39" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="2031" Protect="false" RowAddr="1" RowSpan="1" Width="7098"><CELLMARGIN Bottom="-1" Left="-1" Right="-1" Top="-1"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="38" Style="26"><TEXT CharShape="7"><CHAR>임금차별</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="39" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="2031" Protect="false" RowAddr="1" RowSpan="1" Width="20682"><CELLMARGIN Bottom="-1" Left="-1" Right="-1" Top="-1"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="38" Style="27"><TEXT CharShape="7"/></P></PARALIST></CELL><CELL BorderFill="39" ColAddr="2" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="2031" Protect="false" RowAddr="1" RowSpan="1" Width="21720"><CELLMARGIN Bottom="-1" Left="-1" Right="-1" Top="-1"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="38" Style="25"><TEXT CharShape="7"><CHAR>○</CHAR></TEXT></P></PARALIST></CELL></ROW></TABLE><CHAR/></TEXT></P><P ColumnBreak="false" PageBreak="true" ParaShape="36" Style="0"><TEXT CharShape="33"><CHAR>5）성별임금격차 발생 원인 분석 및 해소 방안</CHAR></TEXT></P><P ParaShape="36" Style="0"><TEXT CharShape="39"><TABLE BorderFill="4" CellSpacing="0" ColCount="1" PageBreak="Cell" RepeatHeader="true" RowCount="1"><SHAPEOBJECT InstId="1796415830" Lock="false" NumberingType="Table" ZOrder="22"><SIZE Height="23571" HeightRelTo="Absolute" Protect="false" Width="49322" WidthRelTo="Absolute"/><POSITION AffectLSpacing="false" AllowOverlap="false" FlowWithText="true" HoldAnchorAndSO="false" HorzAlign="Left" HorzOffset="0" HorzRelTo="Para" TreatAsChar="true" VertAlign="Top" VertOffset="0" VertRelTo="Para"/><OUTSIDEMARGIN Bottom="0" Left="0" Right="0" Top="0"/></SHAPEOBJECT><INSIDEMARGIN Bottom="141" Left="510" Right="510" Top="141"/><ROW><CELL BorderFill="4" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="23571" Protect="false" RowAddr="0" RowSpan="1" Width="49322"><CELLMARGIN Bottom="141" Left="510" Right="510" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="0" Style="0"><TEXT CharShape="40"><CHAR>○ 원인분석</CHAR></TEXT></P><P ParaShape="0" Style="0"><TEXT CharShape="40"><CHAR> - ① 초임 호봉 획정 시 군경력 등 남성의 경력 기간이 여성보다 다소 높은 경향이 있고, </CHAR></TEXT></P><P ParaShape="61" Style="0"><TEXT CharShape="40"><CHAR>   ② 연장/휴일근무 발생시간이 많은 특정 근무형태(3조2교대 등)에 있어서 남성의 비율이 여성에 비해 압도적으로 높으며,</CHAR></TEXT></P><P ParaShape="62" Style="0"><TEXT CharShape="40"><CHAR>   ③ 남성 직원의 야간근로 및 숙직 근로 등 여러 복합적 사유로 성별 임금격차 존재하고 있음 .</CHAR></TEXT></P><P ParaShape="0" Style="0"><TEXT CharShape="40"/></P><P ParaShape="0" Style="0"><TEXT CharShape="40"><CHAR>○ 해소방안</CHAR></TEXT></P><P ParaShape="64" Style="0"><TEXT CharShape="40"><CHAR> - 공단 직원들은 성별에 관계없이 동일한 보수기준을 적용 받고 있으며 승급 및 승진 등에 있어서 성별에 따른 차별을 두고 있지 않음. </CHAR></TEXT></P><P ParaShape="65" Style="0"><TEXT CharShape="40"><CHAR> - 위 성별임금격차 발생 원인들은 근속년수 차이, 연장/휴일근무시간 차이, 야간/숙직근로 여부 등으로 인해 자연적으로 발생하는 요소들로, 근본적인 해소는 어려운 실정임.</CHAR></TEXT></P><P ParaShape="63" Style="0"><TEXT CharShape="40"><CHAR> - 공단의 성별임금격차는 전년 대비 감소하였으며(’23년 79.4% → ’24년 88.7%), 향후 퇴직 및 신규채용 등으로 성별임금격차는 점차 감소할 전망임</CHAR></TEXT></P></PARALIST></CELL></ROW></TABLE><CHAR/></TEXT></P><P ColumnBreak="false" PageBreak="true" ParaShape="0" Style="0"><TEXT CharShape="16"><CHAR>□</CHAR></TEXT><TEXT CharShape="31"><CHAR> 부산환경공단 </CHAR></TEXT><TEXT CharShape="16"/></P><P ParaShape="0" Style="0"><TEXT CharShape="29"/></P><P ParaShape="36" Style="0"><TEXT CharShape="33"><CHAR>1) 직급별 성별임금격차　</CHAR></TEXT></P><P ParaShape="37" Style="0"><TEXT CharShape="29"><CHAR>(단위: %)</CHAR></TEXT></P><P ParaShape="47" Style="0"><TEXT CharShape="29"><TABLE BorderFill="8" CellSpacing="0" ColCount="3" PageBreak="Cell" RepeatHeader="true" RowCount="11"><SHAPEOBJECT InstId="1796415833" Lock="false" NumberingType="Table" TextWrap="TopAndBottom" ZOrder="23"><SIZE Height="20328" HeightRelTo="Absolute" Protect="false" Width="49118" WidthRelTo="Absolute"/><POSITION AffectLSpacing="false" AllowOverlap="false" FlowWithText="true" HoldAnchorAndSO="false" HorzAlign="Left" HorzOffset="0" HorzRelTo="Para" TreatAsChar="false" VertAlign="Top" VertOffset="0" VertRelTo="Para"/><OUTSIDEMARGIN Bottom="0" Left="0" Right="0" Top="0"/></SHAPEOBJECT><INSIDEMARGIN Bottom="141" Left="510" Right="510" Top="141"/><ROW><CELL BorderFill="30" ColAddr="0" ColSpan="1" Dirty="false" E