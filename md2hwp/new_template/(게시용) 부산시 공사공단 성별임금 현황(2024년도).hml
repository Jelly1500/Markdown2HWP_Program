gin="false" Header="false" Height="2031" Protect="false" RowAddr="0" RowSpan="1" Width="20682"><CELLMARGIN Bottom="0" Left="0" Right="0" Top="0"/><PARALIST LineWrap="Squeeze" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="38" Style="26"><TEXT CharShape="7"><CHAR>여</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="38" ColAddr="2" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="2031" Protect="false" RowAddr="0" RowSpan="1" Width="21720"><CELLMARGIN Bottom="0" Left="0" Right="0" Top="0"/><PARALIST LineWrap="Squeeze" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="38" Style="25"><TEXT CharShape="7"><CHAR>부</CHAR></TEXT></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="39" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="2031" Protect="false" RowAddr="1" RowSpan="1" Width="7098"><CELLMARGIN Bottom="-1" Left="-1" Right="-1" Top="-1"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="38" Style="26"><TEXT CharShape="7"><CHAR>임금차별</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="39" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="2031" Protect="false" RowAddr="1" RowSpan="1" Width="20682"><CELLMARGIN Bottom="-1" Left="-1" Right="-1" Top="-1"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="38" Style="27"><TEXT CharShape="7"/></P></PARALIST></CELL><CELL BorderFill="39" ColAddr="2" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="2031" Protect="false" RowAddr="1" RowSpan="1" Width="21720"><CELLMARGIN Bottom="-1" Left="-1" Right="-1" Top="-1"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="38" Style="25"><TEXT CharShape="7"><CHAR>○</CHAR></TEXT></P></PARALIST></CELL></ROW></TABLE><CHAR/></TEXT></P><P ParaShape="51" Style="40"><TEXT CharShape="38"/></P><P ParaShape="36" Style="0"><TEXT CharShape="33"><CHAR>5）성별임금격차 발생 원인 분석 및 해소 방안</CHAR></TEXT></P><P ParaShape="36" Style="0"><TEXT CharShape="39"><TABLE BorderFill="4" CellSpacing="0" ColCount="1" PageBreak="Cell" RepeatHeader="true" RowCount="1"><SHAPEOBJECT InstId="1796415805" Lock="false" NumberingType="Table" ZOrder="12"><SIZE Height="35263" HeightRelTo="Absolute" Protect="false" Width="49322" WidthRelTo="Absolute"/><POSITION AffectLSpacing="false" AllowOverlap="false" FlowWithText="true" HoldAnchorAndSO="false" HorzAlign="Left" HorzOffset="0" HorzRelTo="Para" TreatAsChar="true" VertAlign="Top" VertOffset="0" VertRelTo="Para"/><OUTSIDEMARGIN Bottom="0" Left="0" Right="0" Top="0"/></SHAPEOBJECT><INSIDEMARGIN Bottom="141" Left="510" Right="510" Top="141"/><ROW><CELL BorderFill="4" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="35263" Protect="false" RowAddr="0" RowSpan="1" Width="49322"><CELLMARGIN Bottom="141" Left="510" Right="510" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="0" Style="0"><TEXT CharShape="40"><CHAR>○ 원인분석</CHAR></TEXT></P><P ParaShape="54" Style="0"><TEXT CharShape="29"><CHAR> - 전체성별임금격차 : 공사의 남성의 평균 근속개월 127개월, 여성의 평균 근속개월이 95개월로 여성의 평균 근속개월이 남성에 비해 짧아 관리자급에 포함될 수 있는 모집단 자체가 적기 때문에 고위 직급에 여성관리자가 상대적으로 적음.</CHAR></TEXT></P><P ParaShape="54" Style="0"><TEXT CharShape="29"><CHAR> - 직급별(3~5급) : 남녀 임금 차이를 두지 않고 있으므로 성별임금격차 95% 이상임을 확인 가능</CHAR></TEXT></P><P ParaShape="54" Style="0"><TEXT CharShape="29"><CHAR> - 직급별(6~7급) : 신규입사 직원 중 남성 이직 직원이 많아 여성직원에 비해 상대적 남성 고호봉 직원 수 다수로 인한 임금 격차가 발생</CHAR></TEXT></P><P ParaShape="54" Style="0"><TEXT CharShape="29"><CHAR> - 직급별(공무직) : 비교적 임금 수준이 높은 관리소장이 전원 남성으로 구성되어 성별임금격차 발생</CHAR></TEXT></P><P ParaShape="54" Style="0"><TEXT CharShape="29"><CHAR> - 직종별 : 직종 특성에 따라 고연차 남성 비중이 높은 경우(토목, 건축, 도시재생직 등) 성별임금격차 발생</CHAR></TEXT></P><P ParaShape="55" Style="0"><TEXT CharShape="29"><CHAR> - 재직기간별 : 남녀 임금 차이를 두지 않고 있으므로 재직기간별 성별임금격차 산정 시 대부분의 격차가 90% 전후로 산정되고 있음을 확인 가능</CHAR></TEXT></P><P ParaShape="0" Style="0"><TEXT CharShape="40"/></P><P ParaShape="0" Style="0"><TEXT CharShape="40"><CHAR>○ 해소방안</CHAR></TEXT></P><P ParaShape="54" Style="0"><TEXT CharShape="29"><CHAR> - 평균 성별근속년수가 남성이 여성보다 길지만 남녀 동등한 보수체계를 적용하고 있음. 여성관리자 확대를 위한 역량개발, 일가정양립 문화 정착 등 여성인재 육성 및 경력단절을 위해 노력하고 있음. 또한 신임 기획경영본부장 여성 임용으로 인한 공사 최초 여성 등기이사 채용으로 조직 내 여성 대표성을 확보. </CHAR></TEXT></P><P ParaShape="54" Style="0"><TEXT CharShape="29"><CHAR>   성평등위원회를 운영하며 연간 성평등 계획을 수립하여 성인지 교육, 일가정 양립 제도 실적 향상, 성불평등 사례 조사 등 내부 성별간 불평등 해소를 위해 노력 중. 퇴직 및 신규채용 등으로 인해 성별임금격차는 자연적으로 감소할 것으로 예상됨.</CHAR></TEXT></P></PARALIST></CELL></ROW></TABLE><CHAR/></TEXT></P><P ColumnBreak="false" PageBreak="true" ParaShape="0" Style="0"><TEXT CharShape="16"><CHAR>□</CHAR></TEXT><TEXT CharShape="31"><CHAR> 부산관광공사</CHAR></TEXT><TEXT CharShape="32"/></P><P ParaShape="0" Style="0"><TEXT CharShape="29"/></P><P ParaShape="36" Style="0"><TEXT CharShape="33"><CHAR>1) 직급별 성별임금격차　</CHAR></TEXT></P><P ParaShape="37" Style="0"><TEXT CharShape="29"><CHAR>(단위: %)</CHAR></TEXT></P><P ParaShape="57" Style="0"><TEXT CharShape="29"><TABLE BorderFill="8" CellSpacing="0" ColCount="3" PageBreak="Cell" RepeatHeader="true" RowCount="10"><SHAPEOBJECT InstId="1796415807" Lock="false" NumberingType="Table" ZOrder="13"><SIZE Height="17680" HeightRelTo="Absolute" Protect="false" Width="49118" WidthRelTo="Absolute"/><POSITION AffectLSpacing="false" AllowOverlap="false" FlowWithText="true" HoldAnchorAndSO="false" HorzAlign="Left" HorzOffset="0" HorzRelTo="Para" TreatAsChar="true" VertAlign="Top" VertOffset="0" VertRelTo="Para"/><OUTSIDEMARGIN Bottom="0" Left="0" Right="0" Top="0"/></SHAPEOBJECT><INSIDEMARGIN Bottom="141" Left="510" Right="510" Top="141"/><ROW><CELL BorderFill="30" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="