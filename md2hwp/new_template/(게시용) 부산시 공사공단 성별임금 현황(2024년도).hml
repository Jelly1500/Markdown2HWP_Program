" RowAddr="1" RowSpan="1" Width="20682"><CELLMARGIN Bottom="-1" Left="-1" Right="-1" Top="-1"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="38" Style="27"><TEXT CharShape="7"/></P></PARALIST></CELL><CELL BorderFill="39" ColAddr="2" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="2031" Protect="false" RowAddr="1" RowSpan="1" Width="21720"><CELLMARGIN Bottom="-1" Left="-1" Right="-1" Top="-1"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="38" Style="28"><TEXT CharShape="7"><CHAR>◯</CHAR></TEXT></P></PARALIST></CELL></ROW></TABLE><CHAR/></TEXT></P><P ParaShape="36" Style="0"><TEXT CharShape="33"/></P><P ParaShape="36" Style="0"><TEXT CharShape="33"><CHAR>5）성별임금격차 발생 원인 분석 및 해소 방안</CHAR></TEXT></P><P ParaShape="47" Style="0"><TEXT CharShape="39"><TABLE BorderFill="4" CellSpacing="0" ColCount="1" PageBreak="Cell" RepeatHeader="true" RowCount="1"><SHAPEOBJECT InstId="1796415816" Lock="false" NumberingType="Table" ZOrder="17"><SIZE Height="17979" HeightRelTo="Absolute" Protect="false" Width="49322" WidthRelTo="Absolute"/><POSITION AffectLSpacing="false" AllowOverlap="false" FlowWithText="true" HoldAnchorAndSO="false" HorzAlign="Left" HorzOffset="0" HorzRelTo="Para" TreatAsChar="true" VertAlign="Top" VertOffset="0" VertRelTo="Para"/><OUTSIDEMARGIN Bottom="0" Left="0" Right="0" Top="0"/></SHAPEOBJECT><INSIDEMARGIN Bottom="141" Left="510" Right="510" Top="141"/><ROW><CELL BorderFill="4" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="17979" Protect="false" RowAddr="0" RowSpan="1" Width="49322"><CELLMARGIN Bottom="141" Left="510" Right="510" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="0" Style="0"><TEXT CharShape="40"><CHAR>○ 원인분석</CHAR></TEXT></P><P ParaShape="58" Style="0"><TEXT CharShape="40"><CHAR> - 2</CHAR></TEXT><TEXT CharShape="44"><CHAR>023년 여성노동자 비중 49.14% 대비 47.5%로 1.64% 감소 및 재직기간 10년~20년 미만 성별임금격차</CHAR></TEXT><TEXT CharShape="40"><CHAR> 51.56% 대비 49.21%로 2.35% 감소한 이유는 비교적 고임금 여직원들의 육아휴직 및 기타휴직 사용 발생</CHAR></TEXT></P><P ParaShape="0" Style="0"><TEXT CharShape="40"><CHAR> - 성</CHAR></TEXT><TEXT CharShape="44"><CHAR>별에 따른 임금 지급에 차별을 두는 것이 아니라, 경력산정(군 경력) 등 개별적 요인이 임금격차 유발</CHAR></TEXT></P><P ParaShape="0" Style="0"><TEXT CharShape="40"><CHAR> - 현원 131명 중 21명이 육아 및 기타휴직 중이며, 휴직자의 76.19%가 여직원임(16명)</CHAR></TEXT></P><P ParaShape="0" Style="0"><TEXT CharShape="40"/></P><P ParaShape="0" Style="0"><TEXT CharShape="40"><CHAR>○ 해소방안</CHAR></TEXT></P><P ParaShape="59" Style="0"><TEXT CharShape="40"><CHAR> - 비교적 고임금 여직원의 휴직 복직 및 고령 남직원의 정년퇴직 도래함에 따라 임금 격차는 점차 줄어들 것으로 전망</CHAR></TEXT></P></PARALIST></CELL></ROW></TABLE><CHAR/></TEXT></P><P ColumnBreak="false" PageBreak="true" ParaShape="0" Style="0"><TEXT CharShape="16"><CHAR>□</CHAR></TEXT><TEXT CharShape="31"><CHAR> 부산시설공단</CHAR></TEXT><TEXT CharShape="32"/></P><P ParaShape="0" Style="0"><TEXT CharShape="29"/></P><P ParaShape="36" Style="0"><TEXT CharShape="33"><CHAR>1) 직급별 성별임금격차　</CHAR></TEXT></P><P ParaShape="37" Style="0"><TEXT CharShape="29"><CHAR>(단위: %)</CHAR></TEXT></P><P ParaShape="47" Style="0"><TEXT CharShape="29"><TABLE BorderFill="40" CellSpacing="0" ColCount="3" PageBreak="Cell" RepeatHeader="true" RowCount="16"><SHAPEOBJECT InstId="1796415819" Lock="false" NumberingType="Table" TextWrap="TopAndBottom" ZOrder="18"><SIZE Height="27968" HeightRelTo="Absolute" Protect="false" Width="49118" WidthRelTo="Absolute"/><POSITION AffectLSpacing="false" AllowOverlap="false" FlowWithText="true" HoldAnchorAndSO="false" HorzAlign="Left" HorzOffset="0" HorzRelTo="Para" TreatAsChar="false" VertAlign="Top" VertOffset="0" VertRelTo="Para"/><OUTSIDEMARGIN Bottom="0" Left="0" Right="0" Top="0"/></SHAPEOBJECT><INSIDEMARGIN Bottom="141" Left="510" Right="510" Top="141"/><ROW><CELL BorderFill="30" ColAddr=