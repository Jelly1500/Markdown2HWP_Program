<TEXT CharShape="7"><CHAR>20년 이상</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="33" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="2031" Protect="false" RowAddr="6" RowSpan="1" Width="20682"><CELLMARGIN Bottom="-1" Left="-1" Right="-1" Top="-1"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="38" Style="37"><TEXT CharShape="7"><CHAR>3.73</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="33" ColAddr="2" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="2031" Protect="false" RowAddr="6" RowSpan="1" Width="21720"><CELLMARGIN Bottom="-1" Left="-1" Right="-1" Top="-1"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="38" Style="38"><TEXT CharShape="7"><CHAR>92.01</CHAR></TEXT></P></PARALIST></CELL></ROW></TABLE><CHAR/></TEXT></P><P ParaShape="0" Style="0"><TEXT CharShape="29"/></P><P ParaShape="36" Style="0"><TEXT CharShape="33"><CHAR>4）동일업무(직급)에 대한 성별 임금차별 여부</CHAR></TEXT></P><P ParaShape="20" Style="0"><TEXT CharShape="33"><TABLE BorderFill="8" CellSpacing="0" ColCount="3" PageBreak="Cell" RepeatHeader="true" RowCount="2"><SHAPEOBJECT InstId="1796415789" Lock="false" NumberingType="Table" ZOrder="6"><SIZE Height="4062" HeightRelTo="Absolute" Protect="false" Width="49500" WidthRelTo="Absolute"/><POSITION AffectLSpacing="false" AllowOverlap="false" FlowWithText="true" HoldAnchorAndSO="false" HorzAlign="Left" HorzOffset="0" HorzRelTo="Para" TreatAsChar="true" VertAlign="Top" VertOffset="0" VertRelTo="Para"/><OUTSIDEMARGIN Bottom="0" Left="0" Right="0" Top="0"/></SHAPEOBJECT><INSIDEMARGIN Bottom="141" Left="510" Right="510" Top="141"/><ROW><CELL BorderFill="37" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="2031" Protect="false" RowAddr="0" RowSpan="1" Width="7098"><CELLMARGIN Bottom="-1" Left="-1" Right="-1" Top="-1"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="38" Style="25"><TEXT CharShape="7"><CHAR>구분</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="38" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="2031" Protect="false" RowAddr="0" RowSpan="1" Width="20682"><CELLMARGIN Bottom="0" Left="0" Right="0" Top="0"/><PARALIST LineWrap="Squeeze" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="38" Style="26"><TEXT CharShape="7"><CHAR>여</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="38" ColAddr="2" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="2031" Protect="false" RowAddr="0" RowSpan="1" Width="21720"><CELLMARGIN Bottom="0" Left="0" Right="0" Top="0"/><PARALIST LineWrap="Squeeze" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="38" Style="25"><TEXT CharShape="7"><CHAR>부</CHAR></TEXT></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="39" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="2031" Protect="false" RowAddr="1" RowSpan="1" Width="7098"><CELLMARGIN Bottom="-1" Left="-1" Right="-1" Top="-1"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="38" Style="26"><TEXT CharShape="7"><CHAR>임금차별</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="39" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="2031" Protect="false" RowAddr="1" RowSpan="1" Width="20682"><CELLMARGIN Bottom="-1" Left="-1" Right="-1" Top="-1"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="38" Style="27"><TEXT CharShape="7"/></P></PARALIST></CELL><CELL BorderFill="39" ColAddr="2" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="2031" Protect="false" RowAddr="1" RowSpan="1" Width="21720"><CELLMARGIN Bottom="-1" Left="-1" Right="-1" Top="-1"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="38" Style="25"><TEXT CharShape="7"><CHAR>○</CHAR></TEXT></P></PARALIST></CELL></ROW></TABLE><CHAR/></TEXT></P><P ParaShape="36" Style="0"><TEXT CharShape="33"/></P><P ParaShape="36" Style="0"><TEXT CharShape="33"><CHAR>5）성별임금격차 발생 원인 분석 및 해소 방안</CHAR></TEXT></P><P ParaShape="20" Style="0"><TEXT CharShape="39"><TABLE BorderFill="4" CellSpacing="0" ColCount="1" PageBreak="Cell" RepeatHeader="true" RowCount="1"><SHAPEOBJECT InstId="1796415791" Lock="false" NumberingType="Table" ZOrder="7"><SIZE Height="36957" HeightRelTo="Absolute" Protect="false" Width="49605" WidthRelTo="Absolute"/><POSITION AffectLSpacing="false" AllowOverlap="false" FlowWithText="true" HoldAnchorAndSO="false" HorzAlign="Left" HorzOffset="0" HorzRelTo="Para" TreatAsChar="true" VertAlign="Top" VertOffset="0" VertRelTo="Para"/><OUTSIDEMARGIN Bottom="0" Left="0" Right="0" Top="0"/></SHAPEOBJECT><INSIDEMARGIN Bottom="141" Left="510" Right="510" Top="141"/><ROW><CELL BorderFill="4" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="36957" Protect="false" RowAddr="0" RowSpan="1" Width="49605"><CELLMARGIN Bottom="141" Left="510" Right="510" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="31" Style="0"><TEXT CharShape="40"><CHAR>○ 원인분석</CHAR></TEXT></P><P ParaShape="31" Style="0"><TEXT CharShape="40"><CHAR>ㅇ 기술직 중심의 인력구성 및 근속연수 차이</CHAR></TEXT></P><P ParaShape="0" Style="0"><TEXT CharShape="40"><CHAR>  - 현</CHAR></TEXT><TEXT CharShape="44"><CHAR>재 고직급ㆍ고연차 기술 분야 직원들의 입사당시, 직무내용ㆍ업무선호도 및 사회통념 등에 따라,</CHAR></TEXT></P><P ParaShape="0" Style="0"><TEXT CharShape="40"><CHAR>    남성이 주로 기술 분야에 진출</CHAR></TEXT></P><P ParaShape="0" Style="0"><TEXT CharShape="40"><CHAR>  - 상</CHAR></TEXT><TEXT CharShape="44"><CHAR>기 이유로 공사 인력<FWSPACE/>구조를 살펴봤을 때, 근속연수가 오래될수록 남직원들의 비율이 여직원들에</CHAR></TEXT></P><P ParaShape="0" Style="0"><TEXT CharShape="40"><CHAR>    비해 현저히 높음</CHAR></TEXT></P><P ParaShape="0" Style="0"><TEXT CharShape="40"><CHAR>  - 근</CHAR></TEXT><TEXT CharShape="44"><CHAR>속에 따른 숙련도에 대한 대가를 주요 보상체제로 운용하는 공사 임금체계에 따라, 남직원들의</CHAR></TEXT></P><P ParaShape="0" Style="0"><TEXT CharShape="40"><CHAR>   <FWSPACE/>평균 근속연수가 여직원들에 비해 높으므로, 그에 비례하여 임금 격차가 발생</CHAR></TEXT></P><P ParaShape="0" Style="0"><TEXT CharShape="40"/></P><P ParaShape="0" Style="0"><TEXT CharShape="40"><CHAR>ㅇ 남성 군호봉 인정 차이</CHAR></TEXT></P><P ParaShape="0" Style="0"><TEXT CharShape="40"><CHAR>  - 동일한 재직기간 및 직급으로 변수를 제한하여, 성별간 임금을 비교하였을 때, 임금격차는 95%</CHAR></TEXT></P><P ParaShape="0" Style="0"><TEXT CharShape="40"><CHAR>    내외로 차이가 거의 없음</CHAR></TEXT></P><P ParaShape="0" Style="0"><TEXT CharShape="40"><CHAR>  - 그럼에도 소액의 차이가 발생하는 이유는 남직원들의 군 경력(2~3호봉) 산입 차이로 임금격차가</CHAR></TEXT></P><P ParaShape="0" Style="0"><TEXT CharShape="40"><CHAR>    다소 발생</CHAR></TEXT></P><P ParaShape="0" Style="0"><TEXT CharShape="40"/></P><P ParaShape="31" Style="0"><TEXT CharShape="40"><CHAR>○ 해소방안</CHAR></TEXT></P><P ParaShape="66" Style="0"><TEXT CharShape="40"><CHAR> ㅇ 현재 성별 임금 격차는 성별에 따라 임금체계가 달라지거나, 동일직무 동일임금 원칙이 지켜지지 </CHAR></TEXT></P><P ParaShape="31" Style="0"><TEXT CharShape="40"><CHAR>    않는 등 실질적인 임금지급 차별을 두는 것이 아니라, </CHAR></TEXT></P><P ParaShape="31" Style="0"><TEXT CharShape="40"><CHAR> ㅇ 인력 구조와 함께 근속연수, 경력 등 개별 특정요인이 임금격차를 유발하는 주요 사유로 보이며,</CHAR></TEXT></P><P ParaShape="0" Style="0"><TEXT CharShape="40"><CHAR> ㅇ 이는 2005년 이후 공사 여성 직원 채용 급증 및 여성 직원 구성비율의 단계적 증가와 함께</CHAR></TEXT></P><P ParaShape="0" Style="0"><TEXT CharShape="40"><CHAR>    자연적으로 해소될 것으로 전망됨</CHAR></TEXT></P></PARALIST></CELL></ROW></TABLE><CHAR/></TEXT></P><P ParaShape="40" Style="0"><TEXT CharShape="29"/></P><P ParaShape="40" Style="0"><TEXT CharShape="29"/></P><P ParaShape="40" Style="0"><TEXT CharShape="29"/></P><P ParaShape="0" Style="0"><TEXT CharShape="16"><CHAR>□</CHAR></TEXT><TEXT CharShape="31"><CHAR> 부산도시공사</CHAR></TEXT></P><P ParaShape="50" Style="0"><TEXT CharShape="33"><CHAR>1) 직급별 성별임금격차　</CHAR></TEXT></P><P ParaShape="37" Style="0"><TEXT CharShape="29"><CHAR>(단위: %)</CHAR></TEXT></P><P ParaShape="37" Style="0"><TEXT CharShape="29"><TABLE BorderFill="8" CellSpacing="0" ColCount="3" PageBreak="Cell" RepeatHeader="true" RowCount="22"><SHAPEOBJECT InstId="1796415793" Lock="false" NumberingType="Table" ZOrder="8"><SIZE Height="32230" HeightRelTo="Absolute" Protect="false" Width="49118" WidthRelTo="Absolute"/><POSITION AffectLSpacing="false" AllowOverlap="false" FlowWithText="true" HoldAnchorAndSO="false" HorzAlign="Left" HorzOffset="0" HorzRelTo="Para" TreatAsChar="true" VertAlign="Top" VertOffset="0" VertRelTo="Para"/><OUTSIDEMARGIN Bottom="0" Left="0" Right="0" Top="0"/></SHAPEOBJECT><INSIDEMARGIN Bottom="141" Left="510" Right="510" Top="141"/><ROW><CELL BorderFill="30" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="1465" Protect="false" RowAddr="0" RowSpan="1" Width="7950"><CELLMARGIN Bottom="-1" Left="-1" Right="-1" Top="-1"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="38" Style="25"><TEXT CharShape="7"><CHAR>직급</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="30" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="1465" Protect="false" RowAddr="0" RowSpan="1" Width="20584"><CELLMARGIN Bottom="0" Left="0" Right="0" Top="0"/><PARALIST LineWrap="Squeeze" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="38" Style="26"><TEXT CharShape="7"><CHAR>여성노동자 비중</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="30" ColAddr="2" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="1465" Protect="false" RowAddr="0" RowSpan="1" Width="20584"><CELLMARGIN Bottom="0" 