<CELL BorderFill="3" ColAddr="2" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="2331" Protect="false" RowAddr="2" RowSpan="1" Width="9931"><CELLMARGIN Bottom="141" Left="510" Right="510" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="16" Style="0"><TEXT CharShape="11"><CHAR>8포인트</CHAR></TEXT></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="3" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="4662" Protect="false" RowAddr="3" RowSpan="2" Width="9365"><CELLMARGIN Bottom="141" Left="510" Right="510" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="16" Style="0"><TEXT CharShape="11"><CHAR>첨부문서</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="3" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="2331" Protect="false" RowAddr="3" RowSpan="1" Width="25779"><CELLMARGIN Bottom="141" Left="510" Right="510" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="0" Style="0"><TEXT CharShape="11"><CHAR>일반의약품</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="3" ColAddr="2" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="2331" Protect="false" RowAddr="3" RowSpan="1" Width="9931"><CELLMARGIN Bottom="141" Left="510" Right="510" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="16" Style="0"><TEXT CharShape="11"><CHAR>9포인트</CHAR></TEXT></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="3" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="2331" Protect="false" RowAddr="4" RowSpan="1" Width="25779"><CELLMARGIN Bottom="141" Left="510" Right="510" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="0" Style="0"><TEXT CharShape="11"><CHAR>전문의약품</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="3" ColAddr="2" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="2331" Protect="false" RowAddr="4" RowSpan="1" Width="9931"><CELLMARGIN Bottom="141" Left="510" Right="510" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="16" Style="0"><TEXT CharShape="11"><CHAR>0포인트</CHAR></TEXT></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="3" ColAddr="0" ColSpan="3" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="2614" Protect="false" RowAddr="5" RowSpan="1" Width="45075"><CELLMARGIN Bottom="141" Left="510" Right="510" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="0" Style="0"><TEXT CharShape="11"><CHAR>※ 기재사항의 줄간격은 1.2포인트 이상</CHAR></TEXT></P></PARALIST></CELL></ROW></TABLE><CHAR/></TEXT></P><P ParaShape="23" Style="0"><TEXT CharShape="18"><CHAR>1. </CHAR></TEXT><TEXT CharShape="18"><CHAR>-2147023170: 원격 프로시저를 호출하지 못했습니다.

</CHAR></TEXT></P><P ParaShape="23" Style="0"><TEXT CharShape="18"><CHAR>  * </CHAR></TEXT><TEXT CharShape="18"><CHAR>한글 프로그램이 제대로 초기화되지 않았거나, COM 객체와의 연결이 실패한 경우 발생합니다.</CHAR></TEXT></P><P ParaShape="23" Style="0"><TEXT CharShape="18"><CHAR>  * </CHAR></TEXT><TEXT CharShape="18"><CHAR>한글 프로그램이 이미 실행 중이거나, 예기치 않게 종료되었을 때 COM 연결이 끊어질 수 있습니다.</CHAR></TEXT></P><P ParaShape="23" Style="0"><TEXT CharShape="18"><CHAR>  * </CHAR></TEXT><TEXT CharShape="18"><CHAR>pyhwpx 또는 win32com에서 한글 객체를 생성하거나 조작할 때, 필요한 보안 모듈(FilePathCheckerModule)이 등록되지 않았거나, 한글 프로세스가 비정상적으로 작동 중일 가능성이 있습니다.</CHAR></TEXT></P><P ParaShape="23" Style="0"><TEXT CharShape="18"><CHAR>2. </CHAR></TEXT><TEXT CharShape="18"><CHAR>-2147023174: RPC 서버를 사용할 수 없습니다.

</CHAR></TEXT></P><P ParaShape="23" Style="0"><TEXT CharShape="18"><CHAR>  * </CHAR></TEXT><TEXT CharShape="18"><CHAR>이 오류는 한글 프로그램이 실행 중이던 프로세스가 종료되었거나, COM 인터페이스가 응답하지 않을 때 발생합니다.</CHAR></TEXT></P><P ParaShape="23" Style="0"><TEXT CharShape="18"><CHAR>  * </CHAR></TEXT><TEXT CharShape="18"><CHAR>pyhwpx가 기존에 열린 한글 프로그램과 연결하려고 시도했으나, 해당 인스턴스가 유효하지 않거나 종료된 경우 나타납니다.</CHAR></TEXT></P><P ParaShape="23" Style="0"><TEXT CharShape="18"><CHAR>  * </CHAR></TEXT><TEXT CharShape="18"><CHAR>여러 한글 인스턴스가 동시에 실행 중이거나, pyhwpx가 새 인스턴스를 생성하지 못하고 기존 인스턴스와 충돌할 때도 발생할 수 있습니다.</CHAR></TEXT><TEXT CharShape="30"><FIELDBEGIN Command="https:\/\/www.inflearn.com\/community\/questions\/817204\/2147023174-x27-rpc-%25EC%2584%259C%25EB%25B2%2584%25EB%25A5%25BC-%25EC%2582%25AC%25EC%259A%25A9%25ED%2595%25A0-%25EC%2588%2598-%25EC%2597%2586%25EC%258A%25B5%25EB%258B%2588%25EB%258B%25A4-x27;1;0;0;" Dirty="true" Editable="false" FieldId="0" InstId="1000000" Property="0" Type="Hyperlink"/></TEXT><TEXT CharShape="30"><CHAR></CHAR></TEXT><TEXT CharShape="30"><FIELDEND Editable="false" FieldId="0" Property="0" Type="Hyperlink"/></TEXT><TEXT CharShape="30"><FIELDBEGIN Command="https:\/\/forum.developer.hancom.com\/t\/rpc\/2308;1;0;0;" Dirty="true" Editable="false" FieldId="1" InstId="1000001" Property="0" Type="Hyperlink"/></TEXT><TEXT CharShape="30"><CHAR></CHAR></TEXT><TEXT CharShape="30"><FIELDEND Editable="false" FieldId="1" Property="0" Type="Hyperlink"/></TEXT></P><P ParaShape="23" Style="0"><TEXT CharShape="13"><CHAR> </CHAR><TABLE BorderFill="3" CellSpacing="0" ColCount="3" PageBreak="Cell" RepeatHeader="true" RowCount="6"><SHAPEOBJECT InstId="2066244051" Lock="false" NumberingType="Table" ZOrder="3"><SIZE Height="16515" HeightRelTo="Absolute" Protect="false" Width="45075" WidthRelTo="Absolute"/><POSITION AffectLSpacing="false" AllowOverlap="false" FlowWithText="true" HoldAnchorAndSO="false" HorzAlign="Left" HorzOffset="0" HorzRelTo="Para" TreatAsChar="true" VertAlign="Top" VertOffset="0" VertRelTo="Para"/><OUTSIDEMARGIN Bottom="0" Left="0" Right="0" Top="0"/></SHAPEOBJECT><INSIDEMARGIN Bottom="141" Left="510" Right="510" Top="141"/><ROW><CELL BorderFill="6" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="2897" Protect="false" RowAddr="0" RowSpan="1" Width="9365"><CELLMARGIN Bottom="141" Left="510" Right="510" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="16" Style="0"><TEXT CharShape="17"><CHAR>구분</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="6" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="2897" Protect="false" RowAddr="0" RowSpan="1" Width="25779"><CELLMARGIN Bottom="141" Left="510" Right="510" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="16" Style="0"><TEXT CharShape="17"><CHAR>기재 사항</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="6" ColAddr="2" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="2897" Protect="false" RowAddr="0" RowSpan="1" Width="9931"><CELLMARGIN Bottom="141" Left="510" Right="510" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="16" Style="0"><TEXT CharShape="17"><CHAR>글자 크기</CHAR></TEXT></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="3" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="6342" Protect="false" RowAddr="1" RowSpan="2" Width="9365"><CELLMARGIN Bottom="141" Left="510" Right="510" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="16" Style="0"><TEXT CharShape="11"><CHAR>용기 및 포장</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="3" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="4011" Protect=