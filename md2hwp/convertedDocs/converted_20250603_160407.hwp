ENDNOTESHAPE><PAGEBORDERFILL BorferFill="1" FillArea="Paper" FooterInside="false" HeaderInside="false" TextBorder="true" Type="Both"><PAGEOFFSET Bottom="1417" Left="1417" Right="1417" Top="1417"/></PAGEBORDERFILL><PAGEBORDERFILL BorferFill="1" FillArea="Paper" FooterInside="false" HeaderInside="false" TextBorder="true" Type="Even"><PAGEOFFSET Bottom="1417" Left="1417" Right="1417" Top="1417"/></PAGEBORDERFILL><PAGEBORDERFILL BorferFill="1" FillArea="Paper" FooterInside="false" HeaderInside="false" TextBorder="true" Type="Odd"><PAGEOFFSET Bottom="1417" Left="1417" Right="1417" Top="1417"/></PAGEBORDERFILL></SECDEF><COLDEF Count="1" Layout="Left" SameGap="0" SameSize="true" Type="Newspaper"/><TABLE BorderFill="3" CellSpacing="0" ColCount="2" PageBreak="None" RepeatHeader="true" RowCount="1"><SHAPEOBJECT InstId="1805978308" Lock="false" NumberingType="Table" ZOrder="0"><SIZE Height="2830" HeightRelTo="Absolute" Protect="false" Width="42250" WidthRelTo="Absolute"/><POSITION AffectLSpacing="false" AllowOverlap="false" FlowWithText="true" HoldAnchorAndSO="false" HorzAlign="Left" HorzOffset="0" HorzRelTo="Para" TreatAsChar="true" VertAlign="Top" VertOffset="0" VertRelTo="Para"/><OUTSIDEMARGIN Bottom="140" Left="140" Right="140" Top="140"/></SHAPEOBJECT><INSIDEMARGIN Bottom="140" Left="140" Right="140" Top="140"/><ROW><CELL BorderFill="4" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="2830" Protect="false" RowAddr="0" RowSpan="1" Width="4924"><CELLMARGIN Bottom="141" Left="141" Right="141" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="22" Style="0"><TEXT CharShape="7"><CHAR>제목</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="4" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="2830" Name="제목" Protect="false" RowAddr="0" RowSpan="1" Width="37326"><CELLMARGIN Bottom="141" Left="141" Right="141" Top="141"/><PARALIST LineWrap="Squeeze" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="22" Style="0"><TEXT CharShape="11"><CHAR> </CHAR></TEXT><TEXT CharShape="7"><CHAR>2025년 ○○구 문화예술 프로그램 공모사업 평가 요약</CHAR></TEXT></P></PARALIST></CELL></ROW></TABLE><CHAR/></TEXT></P><P ParaShape="21" Style="0"><TEXT CharShape="20"><CHAR>○○구 문화체육과는 2025년 상반기 문화예술 프로그램 공모사업에 대한
내부 심사 결과를 다음과 같이 요약 정리하였습니다.</CHAR></TEXT></P><P ParaShape="21" Style="0"><TEXT CharShape="25"><CHAR>1. 심사 개요</CHAR></TEXT></P><P ParaShape="29" Style="0"><TEXT CharShape="23"><CHAR>❍ </CHAR></TEXT><TEXT CharShape="20"><CHAR>총 접수 건수: 34건</CHAR></TEXT></P><P ParaShape="29" Style="0"><TEXT CharShape="23"><CHAR>❍ </CHAR></TEXT><TEXT CharShape="20"><CHAR>1차 서류평가 통과: 22건</CHAR></TEXT></P><P ParaShape="29" Style="0"><TEXT CharShape="23"><CHAR>❍ </CHAR></TEXT><TEXT CharShape="20"><CHAR>최종 지원 대상 선정: 14건</CHAR></TEXT></P><P ParaShape="21" Style="0"><TEXT CharShape="20"><CHAR>심사위원: 외부 전문가 3인 + 내부 실무자 2인
평가일시: 2025.05.21.(수)</CHAR></TEXT></P><P ParaShape="21" Style="0"><TEXT CharShape="25"><CHAR>2. 주요 평가 기준</CHAR></TEXT></P><P ParaShape="29" Style="0"><TEXT CharShape="23"><CHAR>1. </CHAR></TEXT><TEXT CharShape="20"><CHAR>기획 완성도 (30점)</CHAR></TEXT><TEXT CharShape="20"><CHAR>
</CHAR></TEXT><TEXT CharShape="20"><CHAR>
</CHAR></TEXT></P><P ParaShape="29" Style="0"><TEXT CharShape="23"><CHAR>  ❍ </CHAR></TEXT><TEXT CharShape="20"><CHAR>목표 명확성, 세부 일정 적절성</CHAR></TEXT></P><P ParaShape="29" Style="0"><TEXT CharShape="23"><CHAR>  ❍ </CHAR></TEXT><TEXT CharShape="20"><CHAR>신청서 작성의 논리성 포함</CHAR></TEXT></P><P ParaShape="29" Style="0"><TEXT CharShape="23"><CHAR>2. </CHAR></TEXT><TEXT CharShape="20"><CHAR>지역 문화기여도 (25점)</CHAR></TEXT><TEXT CharShape="20"><CHAR>
</CHAR></TEXT><TEXT CharShape="20"><CHAR>
</CHAR></TEXT></P><P ParaShape="29" Style="0"><TEXT CharShape="23"><CHAR>  ❍ </CHAR></TEXT><TEXT CharShape="20"><CHAR>지역문화와의 연계성</CHAR></TEXT></P><P ParaShape="29" Style="0"><TEXT CharShape="23"><CHAR>  ❍ </CHAR></TEXT><TEXT CharShape="20"><CHAR>기존 지역 프로그램과의 중복 여부</CHAR></TEXT></P><P ParaShape="29" Style="0"><TEXT CharShape="23"><CHAR>3. </CHAR></TEXT><TEXT CharShape="20"><CHAR>실행 가능성 (25점)</CHAR></TEXT><TEXT CharShape="20"><CHAR>
</CHAR></TEXT><TEXT CharShape="20"><CHAR>
</CHAR></TEXT></P><P ParaShape="29" Style="0"><TEXT CharShape="23"><CHAR>  ❍ </CHAR></TEXT><TEXT CharShape="20"><CHAR>참여 인력 구성의 현실성</CHAR></TEXT></P><P ParaShape="29" Style="0"><TEXT CharShape="23"><CHAR>  ❍ </CHAR></TEXT><TEXT CharShape="20"><CHAR>예산 배분의 적정성</CHAR></TEXT></P><P ParaShape="29" Style="0"><TEXT CharShape="23"><CHAR>4. </CHAR></TEXT><TEXT CharShape="20"><CHAR>지속성 및 후속 가능성 (20점)</CHAR></TEXT><TEXT CharShape="20"><CHAR>
</CHAR></TEXT><TEXT CharShape="20"><CHAR>
</CHAR></TEXT></P><P ParaShape="29" Style="0"><TEXT CharShape="23"><CHAR>  ❍ </CHAR></TEXT><TEXT CharShape="20"><CHAR>단기성 이벤트에 그치지 않는 확장성</CHAR></TEXT></P><P ParaShape="29" Style="0"><TEXT CharShape="23"><CHAR>  ❍ </CHAR></TEXT><TEXT CharShape="20"><CHAR>타 부서 협업 구조 존재 여부</CHAR></TEXT></P><P ParaShape="21" Style="0"><TEXT CharShape="25"><CHAR>3. 점수 구간별 주요 경향</CHAR></TEXT></P><P ParaShape="29" Style="0"><TEXT CharShape="23"><CHAR>❍ </CHAR></TEXT><TEXT CharShape="20"><CHAR>85점 이상 (6건): 기획서가 명확하고 예산도 구체적이며, 지역성도 뛰어남</CHAR></TEXT></P><P ParaShape="29" Style="0"><TEXT CharShape="23"><CHAR>❍ </CHAR></TEXT><TEXT CharShape="20"><CHAR>75~84점 (5건): 내용은 우수하나, 일부 실행 예산의 현실성 부족</CHAR></TEXT></P><P ParaShape="29" Style="0"><TEXT CharShape="23"><CHAR>❍ </CHAR></TEXT><TEXT CharShape="20"><CHAR>65~74점 (3건): 창의성은 있으나 참여자 구성이 불투명하거나 타당성 미흡</CHAR></TEXT></P><P ParaShape="29" Style="0"><TEXT CharShape="23"><CHAR>❍ </CHAR></TEXT><TEXT CharShape="20"><CHAR>64점 이하 (탈락): 신청서 작성 불충분, 유사사업과 차별성 미흡</CHAR></TEXT></P><P ParaShape="21" Style="0"><TEXT CharShape="20"><CHAR>※ 유사성이 높은 사업 2건은 통합 제안 권고 예정</CHAR></TEXT></P><P ParaShape="21" Style="0"><TEXT CharShape="25"><CHAR>4. 유의 사항 및 내부 코멘트 요약</CHAR></TEXT></P><P ParaShape="29" Style="0"><TEXT CharShape="23"><CHAR>❍ </CHAR></TEXT><TEXT CharShape="20"><CHAR>‘○○예술단 협업공연’ 제안서는 전체 내용 중 45%가 과거 실적 반복 기술</CHAR></TEXT></P><P ParaShape="29" Style="0"><TEXT CharShape="23"><CHAR>❍ </CHAR></TEXT><TEXT CharShape="20"><CHAR>‘청소년 미디어창작캠프’는 우수하나, 예산 전액 인건비 구성은 감점 요소</CHAR></TEXT></P><P ParaShape="29" Style="0"><TEXT CharShape="23"><CHAR>❍ </CHAR></TEXT><TEXT CharShape="20"><CHAR>심사표상 평균점수는 78.3점, 지원예산 대비 수용률은 약 62%</CHAR></TEXT></P><P ParaShape="21" Style="0"><TEXT CharShape="20"><CHAR>○○구는 이번 평가 결과를 바탕으로
2026년 공모 시 보다 세분화된 평가 항목을 마련할 예정입니다.</CHAR></TEXT></P><P ParaShape="21" Style="0"><TEXT CharShape="20"><CHAR>문의: 문화체육과 예술정책팀 ☎ 02-456-7891</CHAR></TEXT></P></SECTION></BODY><TAIL><SCRIPTCODE Type="JScript" Version="1.0"><SCRIPTHEADER/><SCRIPTSOURCE/></SCRIPTCODE></TAIL></HWPML>