eak" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="24" Style="0"><TEXT CharShape="8"><CHAR>Ⅰ</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="7" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="3231" Protect="false" RowAddr="0" RowSpan="1" Width="1131"><CELLMARGIN Bottom="141" Left="141" Right="141" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="25" Style="0"><TEXT CharShape="9"/></P></PARALIST></CELL><CELL BorderFill="8" ColAddr="2" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="3231" Protect="false" RowAddr="0" RowSpan="1" Width="26345"><CELLMARGIN Bottom="141" Left="141" Right="141" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ColumnBreak="false" PageBreak="false" ParaShape="26" Style="0"><TEXT CharShape="12"><COLDEF Count="1" Layout="Left" SameGap="0" SameSize="true" Type="Newspaper"/><CHAR>1. 서론</CHAR></TEXT></P></PARALIST></CELL></ROW></TABLE><CHAR/></TEXT></P><P ParaShape="21" Style="0"><TEXT CharShape="22"><CHAR>디지털 전환이 가속화되는 현대 사회에서 인공지능(AI)은 다양한 분야에서 혁신적인 변화를 이끌고 있다. 특히 행정 분야에서는 업무 자동화, 민원 대응, 정책 수립 등에서 인공지능의 도입이 활발히 논의되고 있으며, 그 효과성에 대한 기대가 높다. 본 보고서는 인공지능을 활용한 행정 효율화 방안을 도출하기 위해 다음과 같은 구조로 구성되었다.</CHAR></TEXT></P><P ParaShape="21" Style="0"><TEXT CharShape="17"><TABLE BorderFill="3" CellSpacing="0" ColCount="3" PageBreak="Cell" RepeatHeader="true" RowCount="1"><SHAPEOBJECT InstId="1805978309" Lock="false" NumberingType="Table" ZOrder="1"><SIZE Height="3231" HeightRelTo="Absolute" Protect="false" Width="37035" WidthRelTo="Absolute"/><POSITION AffectLSpacing="false" AllowOverlap="false" FlowWithText="true" HoldAnchorAndSO="false" HorzAlign="Left" HorzOffset="0" HorzRelTo="Para" TreatAsChar="true" VertAlign="Top" VertOffset="0" VertRelTo="Para"/><OUTSIDEMARGIN Bottom="283" Left="283" Right="283" Top="283"/></SHAPEOBJECT><INSIDEMARGIN Bottom="141" Left="141" Right="141" Top="141"/><ROW><CELL BorderFill="6" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="3231" Protect="false" RowAddr="0" RowSpan="1" Width="3705"><CELLMARGIN Bottom="141" Left="141" Right="141" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="24" Style="0"><TEXT CharShape="8"><CHAR>Ⅱ</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="7" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="3231" Protect="false" RowAddr="0" RowSpan="1" Width="1131"><CELLMARGIN Bottom="141" Left="141" Right="141" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="25" Style="0"><TEXT CharShape="9"/></P></PARALIST></CELL><CELL BorderFill="8" ColAddr="2" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="3231" Protect="false" RowAddr="0" RowSpan="1" Width="32199"><CELLMARGIN Bottom="141" Left="141" Right="141" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ColumnBreak="false" PageBreak="false" ParaShape="26" Style="0"><TEXT CharShape="12"><COLDEF Count="1" Layout="Left" SameGap="0" SameSize="true" Type="Newspaper"/><CHAR>2. 배경 및 필요성</CHAR></TEXT></P></PARALIST></CELL></ROW></TABLE><CHAR/></TEXT></P><P ParaShape="23" Style="0"><TEXT CharShape="15"><CHAR>▢ </CHAR></TEXT><TEXT CharShape="22"><CHAR>행정 업무 증가와 인력 부족의 문제</CHAR></TEXT></P><P ParaShape="23" Style="0"><TEXT CharShape="15"><CHAR>▢ </CHAR></TEXT><TEXT CharShape="22"><CHAR>국민의 기대 수준 향상에 따른 대응 체계 고도화 필요</CHAR></TEXT></P><P ParaShape="23" Style="0"><TEXT CharShape="15"><CHAR>▢ </CHAR></TEXT><TEXT CharShape="22"><CHAR>4차 산업혁명 시대의 디지털 행정 혁신 요구</CHAR></TEXT></P><P ParaShape="21" Style="0"><TEXT CharShape="22"><CHAR>이러한 배경은 공공 부문에서도 인공지능의 도입을 통해 보다 체계적이고 신속한 업무 처리가 필요하다는 시사점을 제공한다.</CHAR></TEXT></P><P ParaShape="21" Style="0"><TEXT CharShape="17"><TABLE BorderFill="3" CellSpacing="0" ColCount="3" PageBreak="Cell" RepeatHeader="true" RowCount="1"><SHAPEOBJECT InstId="1805978309" Lock="false" NumberingType="Table" ZOrder="1"><SIZE Height="3231" HeightRelTo="Absolute" Protect="false" Width="42250" WidthRelTo="Absolute"/><POSITION AffectLSpacing="false" AllowOverlap="false" FlowWithText="true" HoldAnchorAndSO="false" HorzAlign="Left" HorzOffset="0" HorzRelTo="Para" TreatAsChar="true" VertAlign="Top" VertOffset="0" VertRelTo="Para"/><OUTSIDEMARGIN Bottom="283" Left="283" Right="283" Top="283"/></SHAPEOBJECT><INSIDEMARGIN Bottom="141" Left="141" Right="141" Top="141"/><ROW><CELL BorderFill="6" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="3231" Protect="false" RowAddr="0" RowSpan="1" Width="3705"><CELLMARGIN Bottom="141" Left="141" Right="141" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="24" Style="0"><TEXT CharShape="8"><CHAR>Ⅲ</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="7" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="3231" Protect="false" RowAddr="0" RowSpan="1" Width="1131"><CELLMARGIN Bottom="141" Left="141" Right="141" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="25" Style="0"><TEXT CharShape="9"/></P></PARALIST></CELL><CELL BorderFill="8" ColAddr="2" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="3231" Protect="false" RowAddr="0" RowSpan="1" Width="37414"><CELLMARGIN Bottom="141" Left="141" Right="141" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ColumnBreak="false" PageBreak="false" ParaShape="26" Style="0"><TEXT CharShape="12"><COLDEF Count="1" Layout="Left" SameGap="0" SameSize="true" Type="Newspaper"/><CHAR>3. 인공지능 기술의 행정 적용 분야 분석</CHAR></TEXT></P></PARALIST></CELL></ROW></TABLE><CHAR/></TEXT></P><P ParaShape="21" Style="0"><TEXT CharShape="18"><TABLE BorderFill="3" CellSpacing="0" ColCount="3" PageBreak="None" RepeatHeader="true" RowCount="1"><SHAPEOBJECT InstId="1805978310" Lock="false" NumberingType="Table" ZOrder="2"><SIZE Height="2263" HeightRelTo="Absolute" Protect="false" Width="27046" WidthRelTo="Absolute"/><POSITION AffectLSpacing="true" AllowOverlap="false" FlowWithText="true" HoldAnchorAndSO="false" HorzAlign="Left" HorzOffset="0" HorzRelTo="Para" TreatAsChar="true" VertAlign="Top" VertOffset="0" VertRelTo="Para"/><OUTSIDEMARGIN Bottom="140" Left="140" Right="140" Top="140"/></SHAPEOBJECT><INSIDEMARGIN Bottom="140" Left="140" Right="140" Top="140"/><ROW><CELL BorderFill="9" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="2263" Protect="false" RowAddr="0" RowSpan="1" Width="2250"><CELLMARGIN Bottom="141" Left="141" Right="141" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="27" Style="0"><TEXT CharShape="13"><CHAR>1</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="10" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="2263" Protect="false" RowAddr="0" RowSpan="1" Width="563"><CELLMARGIN Bottom="141" Left="141" Right="141" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Top"><P ParaShape="28" Style="0"><TEXT CharShape="13"/></P></PARALIST></CELL><CELL BorderFill="11" ColAddr="2" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="2263" Protect="false" RowAddr="0" RowSpan="1" Width="24233"><CELLMARGIN Bottom="141" Left="141" Right="141" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="29" Style="0"><TEXT CharShape="13"><CHAR> </CHAR></TEXT><TEXT CharShape="14"><CHAR>3.1 민원 응대 자동화</CHAR></TEXT></P></PARALIST></CELL></ROW></TABLE><CHAR/></TEXT></P><P ParaShape="23" Style="0"><TEXT CharShape="15"><CHAR>▢ </CHAR></TEXT><TEXT CharShape="23"><CHAR>챗봇 기반 민원 서비스 도입</CHAR></TEXT><TEXT CharShape="22"><CHAR>
</CHAR></TEXT></P><P ParaShape="23" Style="0"><TEXT CharShape="15"><CHAR>  ▢ </CHAR></TEXT><TEXT CharShape="22"><CHAR>기존: 전화 및 방문 중심 → 대기 시간 증가</CHAR></TEXT></P><P ParaShape="23" Style="0"><TEXT CharShape="15"><CHAR>  ▢ </CHAR></TEXT><TEXT CharShape="22"><CHAR>개선: 24시간 응대 가능한 AI 챗봇 배치</CHAR></TEXT></P><P ParaShape="23" Style="0"><TEXT CharShape="15"><CHAR>▢ </CHAR></TEXT><TEXT CharShape="23"><CHAR>자연어 처리 기반 질의 응답</CHAR></TEXT><TEXT CharShape="22"><CHAR>
</CHAR></TEXT></P><P ParaShape="23" Style="0"><TEXT CharShape="15"><CHAR>  ▢ </CHAR></TEXT><TEXT CharShape="22"><CHAR>사용자의 질문을 분석하여 관련 정책, 절차, 문서를 자동 안내</CHAR></TEXT></P><P ParaShape="21" Style="0"><TEXT CharShape="18"><TABLE BorderFill="3" CellSpacing="0" ColCount="3" PageBreak="None" RepeatHeader="true" RowCount="1"><SHAPEOBJECT InstId="1805978310" Lock="false" NumberingType="Table" ZOrder="2"><SIZE Height="2263" HeightRelTo="Absolute" Protect="false" Width="36367" WidthRelTo="Absolute"/><POSITION AffectLSpacing="true" AllowOverlap="false" FlowWithText="true" HoldAnchorAndSO="false" HorzAlign="Left" HorzOffset="0" HorzRelTo="Para" TreatAsChar="true" VertAlign="Top" VertOffset="0" VertRelTo="Para"/><OUTSIDEMARGIN Bottom="140" Left="140" Right="140" Top="140"/></SHAPEOBJECT><INSIDEMARGIN Bottom="140" Left="140" Right="140" Top="140"/><ROW><CELL BorderFill="9" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="2263" Protect="false" RowAddr="0" RowSpan="1" Width="2250"><CELLMARGIN Bottom="141" Left="141" Right="141" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="27" Style="0"><TEXT CharShape="13"><CHAR>1</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="10" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="2263" Protect="false" RowAddr="0" RowSpan="1" Width="563"><CELLMARGIN Bottom="141" Left="141" Right="141" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Top"><P ParaShape="28" Style="0"><TEXT CharShape="13"/></P></PARALIST></CELL><CELL BorderFill="11" ColAddr="2" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="2263" Protect="false" RowAddr="0" RowSpan="1" Width="33554"><CELLMARGIN Bottom="141" Left="141" Right="141" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="29" Style="0"><TEXT CharShape="13"><CHAR> </CHAR></TEXT><TEXT CharShape="14"><CHAR>3.2 문서 작성 및 보고 자동화</CHAR></TEXT></P></PARALIST></CELL></ROW></TABLE><CHAR/></TEXT></P><P ParaShape="23" Style="0"><TEXT CharShape="15"><CHAR>▢ </CHAR></TEXT><TEXT CharShape="23"><CHAR>생성형 AI 활용 자동 보고서 초안 생성</CHAR></TEXT><TEXT CharShape="22"><CHAR>
</CHAR></TEXT></P><P ParaShape="23" Style="0"><TEXT CharShape="15"><CHAR>  ▢ </CHAR></TEXT><TEXT CharShape="22"><CHAR>부서별 주제어 입력 시 정책 보고서 초안 자동 작성</CHAR></TEXT></P><P ParaShape="23" Style="0"><TEXT CharShape="15"><CHAR>▢ </CHAR></TEXT><TEXT CharShape="23"><CHAR>정책 요약, 회의록 자동화</CHAR></TEXT><TEXT CharShape="22"><CHAR>
</CHAR></TEXT></P><P ParaShape="23" Style="0"><TEXT CharShape="15"><CHAR>  ▢ </CHAR></TEXT><TEXT CharShape="22"><CHAR>긴 회의 내용을 요약하여 기록 및 전파 시간 단축</CHAR></TEXT></P><P ParaShape="21" Style="0"><TEXT CharShape="18"><TABLE BorderFill="3" CellSpacing="0" ColCount="3" PageBreak="None" RepeatHeader="true" RowCount="1"><SHAPEOBJECT InstId="1805978310" Lock="false" NumberingType="Table" ZOrder="2"><SIZE Height="2263" HeightRelTo="Absolute" Protect="false" Width="36367" WidthRelTo="Absolute"/><POSITION AffectLSpacing="true" AllowOverlap="false" FlowWithText="true" HoldAnchorAndSO="false" HorzAlign="Left" HorzOffset="0" HorzRelTo="Para" TreatAsChar="true" VertAlign="Top" VertOffset="0" VertRelTo="Para"/><OUTSIDEMARGIN Bottom="140" Left="140" Right="140" Top="140"/></SHAPEOBJECT><INSIDEMARGIN Bottom="140" Left="140" Right="140" Top="140"/><ROW><CELL BorderFill="9" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="2263" Protect="false" RowAddr="0" RowSpan="1" Width="2250"><CELLMARGIN Bottom="141" Left="141" Right="141" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="27" Style="0"><TEXT CharShape="13"><CHAR>1</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="10" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="2263" Protect="false" RowAddr="0" RowSpan="1" Width="563"><CELLMARGIN Bottom="141" Left="141" Right="141" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Top"><P ParaShape="28" Style="0"><TEXT CharShape="13"/></P></PARALIST></CELL><CELL BorderFill="11" ColAddr="2" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="2263" Protect="false" RowAddr="0" RowSpan="1" Width="33554"><CELLMARGIN Bottom="141" Left="141" Right="141" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Ce