848"><CELLMARGIN Bottom="141" Left="141" Right="141" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="21" Style="0"><TEXT CharShape="12"/></P></PARALIST></CELL><CELL BorderFill="11" ColAddr="2" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="2832" Protect="false" RowAddr="0" RowSpan="1" Width="43513"><CELLMARGIN Bottom="141" Left="141" Right="141" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="21" Style="0"><TEXT CharShape="12"><CHAR>1. 추진 배경</CHAR></TEXT></P></PARALIST></CELL></ROW></TABLE><CHAR/></TEXT></P><P ParaShape="20" Style="0"><TEXT CharShape="7"><CHAR>청년 및 중장년층의 구직난과 함께 지역 내 산업 구조의 변화로 인한 일자리 공백이 증가하고 있음. 특히 농어촌, 중소도시 등에서는 맞춤형 일자리 개발의 필요성이 지속적으로 제기되고 있음.</CHAR></TEXT></P><P ParaShape="20" Style="0"><TEXT CharShape="7"><CHAR>지역 자원을 기반으로 한 특화 일자리 창출을 통해 지역경제를 활성화하고, 청년들의 지역 정착 유도 및 중장년층의 재취업 기회를 확대하고자 본 사업을 추진함.</CHAR></TEXT></P><P ParaShape="20" Style="0"><TEXT CharShape="14"><TABLE BorderFill="8" CellSpacing="0" ColCount="3" PageBreak="Cell" RepeatHeader="true" RowCount="1"><SHAPEOBJECT InstId="1808830185" Lock="false" NumberingType="Table" ZOrder="1"><SIZE Height="2832" HeightRelTo="Absolute" Protect="false" Width="47688" WidthRelTo="Absolute"/><POSITION AffectLSpacing="false" AllowOverlap="false" FlowWithText="true" HoldAnchorAndSO="false" HorzAlign="Left" HorzOffset="0" HorzRelTo="Para" TreatAsChar="true" VertAlign="Top" VertOffset="0" VertRelTo="Para"/><OUTSIDEMARGIN Bottom="283" Left="283" Right="283" Top="283"/></SHAPEOBJECT><INSIDEMARGIN Bottom="141" Left="141" Right="141" Top="141"/><ROW><CELL BorderFill="9" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="2832" Protect="false" RowAddr="0" RowSpan="1" Width="3327"><CELLMARGIN Bottom="141" Left="141" Right="141" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="24" Style="0"><TEXT CharShape="8"><CHAR>Ⅱ</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="10" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="2832" Protect="false" RowAddr="0" RowSpan="1" Width="848"><CELLMARGIN Bottom="141" Left="141" Right="141" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="21" Style="0"><TEXT CharShape="12"/></P></PARALIST></CELL><CELL BorderFill="11" ColAddr="2" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="2832" Protect="false" RowAddr="0" RowSpan="1" Width="43513"><CELLMARGIN Bottom="141" Left="141" Right="141" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="21" Style="0"><TEXT CharShape="12"><CHAR>2. 사업 개요</CHAR></TEXT></P></PARALIST></CELL></ROW></TABLE><CHAR/></TEXT></P><P ParaShape="23" Style="0"><TEXT CharShape="18"><CHAR>○ </CHAR></TEXT><TEXT CharShape="20"><CHAR>사업명:</CHAR></TEXT><TEXT CharShape="7"><CHAR> 지역 특화 일자리 창출 사업</CHAR></TEXT></P><P ParaShape="23" Style="0"><TEXT CharShape="18"><CHAR>○ </CHAR></TEXT><TEXT CharShape="20"><CHAR>사업기간:</CHAR></TEXT><TEXT CharShape="7"><CHAR> 2025년 6월 ~ 2026년 5월 (1년간)</CHAR></TEXT></P><P ParaShape="23" Style="0"><TEXT CharShape="18"><CHAR>○ </CHAR></TEXT><TEXT CharShape="20"><CHAR>사업대상:</CHAR></TEXT><TEXT CharShape="7"><CHAR> 지역 내 미취업 청년, 경력단절 중장년층, 취약계층 등</CHAR></TEXT></P><P ParaShape="23" Style="0"><TEXT CharShape="18"><CHAR>○ </CHAR></TEXT><TEXT CharShape="20"><CHAR>지원규모:</CHAR></TEXT><TEXT CharShape="7"><CHAR> 총 10억 원 (지방비 6억 원, 국비 4억 원)</CHAR></TEXT></P><P ParaShape="20" Style="0"><TEXT CharShape="14"><TABLE BorderFill="8" CellSpacing="0" ColCount="3" PageBreak="Cell" RepeatHeader="true" RowCount="1"><SHAPEOBJECT InstId="1808830185" Lock="false" NumberingType="Table" ZOrder="1"><SIZE Height="2832" HeightRelTo="Absolute" Protect="false" Width="47688" WidthRelTo="Absolute"/><POSITION AffectLSpacing="false" AllowOverlap="false" FlowWithText="true" HoldAnchorAndSO="false" HorzAlign="Left" HorzOffset="0" HorzRelTo="Para" TreatAsChar="true" VertAlign="Top" VertOffset="0" VertRelTo="Para"/><OUTSIDEMARGIN Bottom="283" Left="283" Right="283" Top="283"/></SHAPEOBJECT><INSIDEMARGIN Bottom="141" Left="141" Right="141" Top="141"/><ROW><CELL BorderFill="9" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="2832" Protect="false" RowAddr="0" RowSpan="1" Width="3327"><CELLMARGIN Bottom="141" Left="141" Right="141" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="24" Style="0"><TEXT CharShape="8"><CHAR>Ⅲ</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="10" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="2832" Protect="false" RowAddr="0" RowSpan="1" Width="848"><CELLMARGIN Bottom="141" Left="141" Right="141" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="21" Style="0"><TEXT CharShape="12"/></P></PARALIST></CELL><CELL BorderFill="11" ColAddr="2" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="2832" Protect="false" RowAddr="0" RowSpan="1" Width="43513"><CELLMARGIN Bottom="141" Left="141" Right="141" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="21" Style="0"><TEXT CharShape="12"><CHAR>3. 주요 사업 내용</CHAR></TEXT></P></PARALIST></CELL></ROW></TABLE><CHAR/></TEXT></P><P ParaShape="22" Style="0"><TEXT CharShape="18"><CHAR> □ </CHAR></TEXT><TEXT CharShape="19"><CHAR>3.1 지역산업 연계 일자리 발굴</CHAR></TEXT></P><P ParaShape="23" Style="0"><TEXT CharShape="18"><CHAR>1. </CHAR></TEXT><TEXT CharShape="7"><CHAR>지역 특화작물 가공사업체와 연계한 생산·포장 인력 채용</CHAR></TEXT></P><P ParaShape="23" Style="0"><TEXT CharShape="18"><CHAR>2. </CHAR></TEXT><TEXT CharShape="7"><CHAR>전통시장 및 로컬푸드 직매장과 연계한 판매·홍보직 신설</CHAR></TEXT></P><P ParaShape="23" Style="0"><TEXT CharShape="18"><CHAR>3. </CHAR></TEXT><TEXT CharShape="7"><CHAR>농촌 관광자원 해설사, 체험마을 운영인력 양성</CHAR></TEXT></P><P ParaShape="22" Style="0"><TEXT CharShape="18"><CHAR> □ </CHAR></TEXT><TEXT CharShape="19"><CHAR>3.2 일자리 맞춤 교육 및 훈련</CHAR></TEXT></P><P ParaShape="23" Style="0"><TEXT CharShape="18"><CHAR>○ </CHAR></TEXT><TEXT CharShape="7"><CHAR>직무별 실무 중심 교육과정 개설</CHAR></TEXT></P><P ParaShape="23" Style="0"><TEXT CharShape="18"><CHAR>○ </CHAR></TEXT><TEXT CharShape="7"><CHAR>지역 대학 및 평생교육기관과 협업한 자격증 과정 운영</CHAR></TEXT></P><P ParaShape="23" Style="0"><TEXT CharShape="18"><CHAR>○ </CHAR></TEXT><TEXT CharShape="7"><CHAR>실습 중심 훈련을 통한 현장 적응력 강화</CHAR></TEXT></P><P ParaShape="22" Style="0"><TEXT CharShape="18"><CHAR> □ </CHAR></TEXT><TEXT CharShape="19"><CHAR>3.3 취업 연계 및 사후 관리</CHAR></TEXT></P><P ParaShape="23" Style="0"><TEXT CharShape="18"><CHAR>○ </CHAR></TEXT><TEXT CharShape="7"><CHAR>취업박람회 개최 및 현장 면접 지원</CHAR></TEXT></P><P ParaShape="23" Style="0"><TEXT CharShape="18"><CHAR>○ </CHAR></TEXT><TEXT CharShape="7"><CHAR>일자리 매칭 시스템을 통한 맞춤형 연계</CHAR></TEXT></P><P ParaShape="23" Style="0"><TEXT CharShape="18"><CHAR>○ </CHAR></TEXT><TEXT CharShape="7"><CHAR>6개월 이상 고용 유지 시 인센티브 지급</CHAR></TEXT></P><P ParaShape="20" Style="0"><TEXT CharShape="14"><TABLE BorderFill="8" CellSpacing="0" ColCount="3" PageBreak="Cell" RepeatHeader="true" RowCount="1"><SHAPEOBJECT InstId="1808830185" Lock="false" NumberingType="Table" ZOrder="1"><SIZE Height="2832" HeightRelTo="Absolute" Protect="false" Width="47688" WidthRelTo="Absolute"/><POSITION AffectLSpacing="false" AllowOverlap="false" FlowWithText="true" HoldAnchorAndSO="false" HorzAlign="Left" HorzOffset="0" HorzRelTo="Para" TreatAsChar="true" VertAlign="Top" VertOffset="0" VertRelTo="Para"/><OUTSIDEMARGIN Bottom="283" Left="283" Right="283" Top="283"/></SHA