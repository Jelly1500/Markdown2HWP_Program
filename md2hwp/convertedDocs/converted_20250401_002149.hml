EXT></P><P ParaShape="23" Style="0"><TEXT CharShape="18"><CHAR>○ </CHAR></TEXT><TEXT CharShape="20"><CHAR>일자리정책과:</CHAR></TEXT><TEXT CharShape="7"><CHAR> 전체 사업 총괄, 예산 관리</CHAR></TEXT></P><P ParaShape="23" Style="0"><TEXT CharShape="18"><CHAR>○ </CHAR></TEXT><TEXT CharShape="20"><CHAR>농업기술센터:</CHAR></TEXT><TEXT CharShape="7"><CHAR> 특화작물 관련 일자리 협업</CHAR></TEXT></P><P ParaShape="23" Style="0"><TEXT CharShape="18"><CHAR>○ </CHAR></TEXT><TEXT CharShape="20"><CHAR>관광과:</CHAR></TEXT><TEXT CharShape="7"><CHAR> 관광 인력 훈련 및 운영 지원</CHAR></TEXT></P><P ParaShape="23" Style="0"><TEXT CharShape="18"><CHAR>○ </CHAR></TEXT><TEXT CharShape="20"><CHAR>복지과:</CHAR></TEXT><TEXT CharShape="7"><CHAR> 취약계층 대상 발굴 및 안내</CHAR></TEXT></P><P ParaShape="20" Style="0"><TEXT CharShape="14"><TABLE BorderFill="8" CellSpacing="0" ColCount="3" PageBreak="Cell" RepeatHeader="true" RowCount="1"><SHAPEOBJECT InstId="1808830185" Lock="false" NumberingType="Table" ZOrder="1"><SIZE Height="2832" HeightRelTo="Absolute" Protect="false" Width="47688" WidthRelTo="Absolute"/><POSITION AffectLSpacing="false" AllowOverlap="false" FlowWithText="true" HoldAnchorAndSO="false" HorzAlign="Left" HorzOffset="0" HorzRelTo="Para" TreatAsChar="true" VertAlign="Top" VertOffset="0" VertRelTo="Para"/><OUTSIDEMARGIN Bottom="283" Left="283" Right="283" Top="283"/></SHAPEOBJECT><INSIDEMARGIN Bottom="141" Left="141" Right="141" Top="141"/><ROW><CELL BorderFill="9" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="2832" Protect="false" RowAddr="0" RowSpan="1" Width="3327"><CELLMARGIN Bottom="141" Left="141" Right="141" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="24" Style="0"><TEXT CharShape="8"><CHAR>Ⅶ</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="10" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="2832" Protect="false" RowAddr="0" RowSpan="1" Width="848"><CELLMARGIN Bottom="141" Left="141" Right="141" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="21" Style="0"><TEXT CharShape="12"/></P></PARALIST></CELL><CELL BorderFill="11" ColAddr="2" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="2832" Protect="false" RowAddr="0" RowSpan="1" Width="43513"><CELLMARGIN Bottom="141" Left="141" Right="141" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="21" Style="0"><TEXT CharShape="12"><CHAR>7. 결론</CHAR></TEXT></P></PARALIST></CELL></ROW></TABLE><CHAR/></TEXT></P><P ParaShape="20" Style="0"><TEXT CharShape="7"><CHAR>본 사업은 지역의 고유한 자원과 특성을 활용하여 실효성 있는 일자리를 창출하고, 지역 사회 구성원의 삶의 질 향상에 기여하는 것을 목표로 한다. 부서 간 긴밀한 협력을 통해 사업이 성공적으로 추진될 수 있도록 적극적인 참여와 지원을 요청함.</CHAR></TEXT></P></SECTION></BODY><TAIL><SCRIPTCODE Type="JScript" Version="1.0"><SCRIPTHEADER/><SCRIPTSOURCE/></SCRIPTCODE></TAIL></HWPML>